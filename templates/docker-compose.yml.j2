services:
  db:
    image: postgres:15-alpine
    container_name: workspace-db
    restart: always
    volumes:
      - ./postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=nextcloud
      - POSTGRES_USER=nextcloud
      - POSTGRES_PASSWORD=SuperSecretDbPassword123!
    networks:
      - workspace-net

  redis:
    image: redis:7-alpine
    container_name: workspace-redis
    restart: always
    command: redis-server --requirepass SuperSecretRedisPassword123!
    volumes:
      - ./redis:/data
    networks:
      - workspace-net

  onlyoffice:
    image: onlyoffice/documentserver:latest
    container_name: workspace-office
    restart: always
    environment:
      - JWT_ENABLED=true
      - JWT_SECRET=YourOnlyOfficeJwtSecretKey987!
      - JWT_HEADER=Authorization
      - REDIS_SERVER_HOST=redis
      - REDIS_SERVER_PORT=6379
      - REDIS_SERVER_PASSWORD=SuperSecretRedisPassword123!
    volumes:
      - ./onlyoffice/data:/var/www/onlyoffice/Data
      - ./onlyoffice/logs:/var/log/onlyoffice
      - ./onlyoffice/fonts:/usr/share/fonts/truetype/custom
    extra_hosts:
      - "nextcloud.exemple.ts.net:127.0.0.1"
    networks:
      - workspace-net

  nextcloud:
    image: nextcloud:30-fpm-alpine
    container_name: workspace-nextcloud
    restart: always
    depends_on:
      - db
      - redis
    volumes:
      - ./nextcloud:/var/www/html
    environment:
      - POSTGRES_HOST=db
      - POSTGRES_DB=nextcloud
      - POSTGRES_USER=nextcloud
      - POSTGRES_PASSWORD=SuperSecretDbPassword123!
    networks:
      - workspace-net

  n8n:
    image: docker.n8n.io/n8nio/n8n:latest
    container_name: workspace-n8n
    restart: always
    ports:
      - "5678:5678"
    environment:
      - N8N_SECURE_COOKIE=false
    volumes:
      - ./n8n:/home/node/.n8n
    depends_on:
      - db
    networks:
      - workspace-net

  grafana:
    image: grafana/grafana-oss:latest
    container_name: workspace-grafana
    restart: always
    ports:
      - "3000:3000"
    volumes:
      - ./grafana:/var/lib/grafana
    depends_on:
      - db
    networks:
      - workspace-net

  web:
    image: nginx:alpine
    container_name: workspace-web
    restart: always
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nextcloud:/var/www/html:ro
    entrypoint: /bin/sh -c "rm -f /etc/nginx/conf.d/* && exec nginx -g 'daemon off;'"
    depends_on:
      - nextcloud
      - onlyoffice
    networks:
      workspace-net:
        aliases:
          - nextcloud.exemple.ts.net

networks:
  workspace-net:
    name: workspace-net
    driver: bridge